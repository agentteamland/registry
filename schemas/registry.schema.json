{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agentteamland/registry/main/schemas/registry.schema.json",
  "title": "AgentTeamLand Registry",
  "description": "Schema for teams.json — the canonical list of AgentTeamLand teams installable by name via /team install <name>.",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "teams"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema version number."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last registry update."
    },
    "teams": {
      "type": "array",
      "items": { "$ref": "#/$defs/TeamEntry" },
      "uniqueItems": true,
      "description": "Array of registered teams."
    }
  },
  "$defs": {
    "TeamEntry": {
      "type": "object",
      "required": ["name", "repo", "description", "latestVersion", "author", "status", "addedAt"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
          "description": "Unique kebab-case name. Matches team.json's 'name' field."
        },
        "repo": {
          "type": "string",
          "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+(?:\\.git)?$",
          "description": "HTTPS clone URL (GitHub only for now)."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "latestVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$",
          "description": "The current latest SemVer release of the team. Updated by maintainers or CI."
        },
        "author": {
          "type": "string",
          "description": "GitHub username or organization slug of the team author."
        },
        "authorUrl": {
          "type": "string",
          "format": "uri",
          "description": "Optional homepage of the author."
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20,
          "uniqueItems": true
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string",
          "enum": ["verified", "community", "deprecated"],
          "description": "verified = reviewed + tested by AgentTeamLand. community = user-submitted, link-only (quality not guaranteed). deprecated = retained for install compatibility but not recommended."
        },
        "addedAt": {
          "type": "string",
          "format": "date",
          "description": "ISO date (YYYY-MM-DD) when this entry was added to the registry."
        },
        "deprecatedReason": {
          "type": "string",
          "description": "If status=deprecated, short explanation."
        },
        "replacedBy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "If status=deprecated, the recommended replacement team name."
        }
      }
    }
  }
}
